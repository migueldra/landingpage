generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/aura_drive_landing/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(cuid())
  nombre      String
  apellidos   String
  telefono    String
  departamento String
  ciudad      String
  direccion   String
  complementos String?
  email       String
  fragancia   String   @default("Lavanda Relajante")
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
